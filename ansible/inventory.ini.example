[control_plane]
control-plane ansible_host=CONTROL_PLANE_PUBLIC_IP ansible_user=ec2-user

[workers]
worker-1 ansible_host=WORKER_PUBLIC_IP ansible_user=ec2-user

[kubernetes:children]
control_plane
workers

[kubernetes:vars]
ansible_ssh_private_key_file=~/.ssh/aws-kubernetes-project
ansible_python_interpreter=/usr/bin/python3
